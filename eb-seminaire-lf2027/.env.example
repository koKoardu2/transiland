# Copiez ce fichier en .env puis renseignez les valeurs. Ne commitez JAMAIS .env.
PORT=3000
# URL publique de la plateforme (utilisée pour les redirections Chariow)
PUBLIC_URL=http://localhost:3000

# --- Chariow ---
# Clé secrète API (Chariow > Paramètres > Développeur > Clés API)
CHARIOW_API_KEY=sk_xxxxxxxx
CHARIOW_API_URL=https://api.chariow.com/v1
# Identifiants des produits Chariow (un produit = une place, prix TTC identique à la plateforme)
CHARIOW_PRODUCT_STANDARD=prd_xxxxxxxx
CHARIOW_PRODUCT_PREMIUM=prd_xxxxxxxx
# Secret de signature du Pulse (webhook) : Automatisations > Pulses > votre Pulse
CHARIOW_PULSE_SECRET=whsec_xxxxxxxx
# "live" (par défaut si une clé est fournie) ou "mock" pour tester sans paiement réel
CHARIOW_MODE=live

# --- Back-office ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi
